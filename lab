    const photoPages={welwitschia:'https://genk.vn/welwitschia-mirabilis-loai-thuc-vat-co-xua-co-kha-nang-ton-tai-hang-nghin-nam-20231015131812499.chn',rafflesia:'https://commons.wikimedia.org/wiki/File:Rafflesia_arnoldii_Bunga_Nasional_Indonesia_01.jpg',hydnora:'https://www.nationalgeographic.fr/sciences/doigts-du-diable-ces-tentacules-appartiennent-a-un-champignon-insolite-anthurus-archer',nepenthes:'https://www.kew.org/read-and-watch/species-named-after-sir-david-attenborough',flytrap:'https://commons.wikimedia.org/wiki/File:Dionaea_muscipula_002.JPG',titanArum:'https://commons.wikimedia.org/wiki/Category:Amorphophallus_titanum',hammerOrchid:'https://www.inaturalist.org/guide_taxa/1107591',roridula:'https://commons.wikimedia.org/wiki/File:RoridulaGorgonias.jpg'};
    const plants=[
      {id:'01',latin:'Welwitschia mirabilis',name:'千岁兰',kind:'荒漠生存',group:'desert',place:'纳米布沙漠 · 安哥拉 / 纳米比亚',size:'两片叶，终生生长',fact:'它一生只长出两片叶子。叶尖不断磨损、撕裂，常被误认成一大团枯叶；有些个体可能活过千年。',desc:'千岁兰把幼苗时期长出的两片叶保留一生，并持续从叶基生长。在极端干燥的纳米布沿海沙漠，它还能利用海雾与深长的主根获取水分。',source:'https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:383591-1/general-information',art:svg.welwitschia,tag:'LIVING FOSSIL'},
      {id:'02',latin:'Rafflesia arnoldii',name:'阿诺尔特大王花',kind:'寄生植物',group:'parasitic',place:'苏门答腊 / 婆罗洲热带雨林',size:'花径可达约 1 米',fact:'它没有叶、茎和根，大部分生命都藏在葡萄科崖爬藤属植物体内；开花时会散发腐肉气味吸引蝇类。',desc:'大王花是全寄生植物，只有花朵从寄主藤本的组织中长出。花朵可达约一米宽，肉红色花瓣布满浅色斑点，靠食腐蝇类传粉。',source:'https://www.kew.org/plants/rafflesia-arnoldi',art:svg.rafflesia,tag:'PARASITIC / GIANT'},
      {id:'03',latin:'Hydnora africana',name:'非洲白鹭花',kind:'寄生植物',group:'parasitic',place:'南部非洲干旱地区',size:'花高约 10–15 厘米',fact:'整株几乎都埋在地下，没有叶绿素；雨后才会冒出一朵肉质花，靠气味吸引食腐甲虫。',desc:'白鹭花寄生在灌木根部，地上通常只见到花。它的果实也在地下发育；花朵会暂时留住甲虫，让甲虫沾上花粉后再离开。',source:'https://www.kew.org/plants/hydnora-africana',art:svg.hydnora,tag:'SUBTERRANEAN'},
      {id:'04',latin:'Nepenthes attenboroughii',name:'阿滕伯勒猪笼草',kind:'食虫植物',group:'carnivorous',place:'菲律宾巴拉望岛高山',size:'大型捕虫瓶可容纳雨水',fact:'它的捕虫瓶不只是陷阱：积水层中还有水生昆虫幼体生活，形成一个微型生态系统。',desc:'这类猪笼草生长在贫瘠土壤中，以捕虫瓶补充营养。阿滕伯勒猪笼草仅见于巴拉望岛，巨大的瓶状叶会收集雨水；有些幼虫能在水层中发育。',source:'https://www.kew.org/read-and-watch/species-named-after-sir-david-attenborough',art:svg.nepenthes,tag:'PITCHER / ECOSYSTEM'},
      {id:'05',latin:'Dionaea muscipula',name:'捕蝇草',kind:'食虫植物',group:'carnivorous',place:'美国北卡罗来纳州 / 南卡罗来纳州',size:'约 20 秒内触碰两次才闭合',fact:'捕虫夹内侧的触发毛需要在短时间内被碰触两次，陷阱才会合拢——这是它避免被雨滴误触的“短期记忆”。',desc:'捕蝇草生活在缺乏养分的湿地。每片叶子末端都有带齿的捕虫夹，感受到合适的连续刺激后迅速闭合，再分泌消化液吸收猎物中的养分。',source:'https://www.kew.org/plants/venus-flytrap',art:svg.flytrap,tag:'CARNIVOROUS / MEMORY'},
      {id:'06',latin:'Amorphophallus titanum',name:'巨魔芋',kind:'巨型花序',group:'other',place:'印度尼西亚苏门答腊岛雨林',size:'花序可高达约 3 米',fact:'它的“巨花”其实不是一朵花，而是一整簇小花组成的花序；开花时会发热并散发腐肉气味。',desc:'巨魔芋原生于苏门答腊的雨林。它把许多小花聚集在一根肉穗花序上，外侧由佛焰苞包围；开花时释放的气味会吸引以腐肉为食的昆虫。',source:'https://www.kew.org/read-and-watch/the-giant-pongy-plant-titan-arum',art:svg.nepenthes,tag:'TITAN / INFLORESCENCE'},
      {id:'07',latin:'Drakaea glyptodon',name:'锤兰',kind:'欺骗传粉',group:'other',place:'澳大利亚西南部',size:'花唇形似无翅雌蜂',fact:'它会用形态和化学气味模仿雌蜂，吸引雄蜂前来交配；雄蜂尝试抱起花朵时，便帮助兰花完成传粉。',desc:'锤兰是澳大利亚西南部特有的一类兰花。它的花唇模拟雌性 thynnine 黄蜂，气味也能欺骗雄蜂；雄蜂的求偶行为让花粉块附着在它身上，再被带到下一朵花。',source:'https://nph.onlinelibrary.wiley.com/doi/10.1111/nph.12800',art:svg.flytrap,tag:'POLLINATION / DECEPTION'},
      {id:'08',latin:'Roridula gorgonias',name:'美杜莎捕虫木',kind:'共生捕虫',group:'other',place:'南非西开普省',size:'叶面布满黏性腺毛',fact:'黏液能粘住昆虫，但它自己不产生消化酶；捕食蝽吃掉猎物后，捕虫木会吸收蝽排出的养分。',desc:'捕虫木生长在南非西开普的贫瘠土壤中。它的黏性叶片能捕住昆虫，却不直接分泌消化酶；捕食蝽会在叶面上活动、吃掉被粘住的昆虫，而植物从蝽的排泄物中获得养分。',source:'https://botanicalgarden.berkeley.edu/collections/orchid-fern-and-carnivorous-plant-house/',art:svg.welwitschia,tag:'SYMBIOSIS / TRAP'}
    ];
    const grid=document.querySelector('#plantGrid');
    const photo=(key,alt)=>`<img class="plant-photo" src="${photos[key]}" alt="${alt}" loading="lazy">`;
    grid.innerHTML=plants.map((p,i)=>`<button class="card" data-group="${p.group}" data-id="${p.id}" aria-label="打开${p.name}档案"><div class="card-visual"><span class="card-no mono">NO. ${p.id}</span><span class="card-kind mono">${p.tag}</span>${photo(photoKeys[i],`${p.name}的真实植物影像`)}</div><div class="card-info"><div><div class="latin">${p.latin}</div><div class="common">${p.name}</div><div class="loc">⌖ ${p.place}</div></div><span class="arrow">↗</span></div></button>`).join('');
    const dialog=document.querySelector('#plantDialog');
    grid.addEventListener('click',e=>{const card=e.target.closest('.card');if(!card)return;const p=plants.find(x=>x.id===card.dataset.id),i=plants.indexOf(p),art=document.querySelector('#modalArt');art.innerHTML=photo(photoKeys[i],`${p.name}真实植物影像`)+`<div class="scan-lens" role="img" aria-label="拖动扫描镜查看植物细节"><span>DRAG / SCAN ×2.4</span></div>`;art.querySelector('.scan-lens').style.backgroundImage=`url("${photos[photoKeys[i]]}")`;document.querySelector('#modalCopy').innerHTML=`<div class="tag">SPECIMEN ${p.id} / ${p.tag}</div><h3 id="modalName">${p.name}</h3><div class="latin">${p.latin}</div><div class="facts"><div><b>分布</b><span>${p.place}</span></div><div><b>观察记录</b><span>${p.size}</span></div></div><p>${p.desc}</p><p><strong style="color:var(--acid)">奇异档案：</strong>${p.fact}</p><a class="source" href="${p.source}" target="_blank" rel="noreferrer">查看参考资料 ↗</a><p class="mono" style="font-size:9px;margin-top:18px;color:#9baac0">IMAGE SOURCE · <a href="${photoPages[photoKeys[i]]}" target="_blank" rel="noreferrer">打开影像来源</a></p>`;});
    grid.addEventListener('click',e=>{if(!e.target.closest('.card'))return;dialog.dataset.closing='';dialog.showModal()});
    const modalArt=document.querySelector('#modalArt');let scanning=false;
    modalArt.addEventListener('pointerdown',e=>{const lens=e.target.closest('.scan-lens');if(!lens)return;scanning=true;lens.classList.add('is-dragging');lens.setPointerCapture(e.pointerId);moveLens(e,lens);});
    modalArt.addEventListener('pointermove',e=>{if(!scanning)return;const lens=modalArt.querySelector('.scan-lens');if(lens)moveLens(e,lens);});
    const endScan=()=>{scanning=false;modalArt.querySelector('.scan-lens')?.classList.remove('is-dragging')};modalArt.addEventListener('pointerup',endScan);modalArt.addEventListener('pointercancel',endScan);
    function moveLens(e,lens){const r=modalArt.getBoundingClientRect(),size=lens.offsetWidth,x=Math.max(size/2,Math.min(r.width-size/2,e.clientX-r.left)),y=Math.max(size/2,Math.min(r.height-size/2,e.clientY-r.top));lens.style.left=`${x/r.width*100}%`;lens.style.top=`${y/r.height*100}%`;lens.style.backgroundPosition=`${x/r.width*100}% ${y/r.height*100}%`}
    const closeDialog=()=>{if(!dialog.open||dialog.dataset.closing)return;dialog.dataset.closing='true';if(window.gsap&&!matchMedia('(prefers-reduced-motion: reduce)').matches){gsap.timeline({onComplete:()=>{dialog.close();delete dialog.dataset.closing}}).to('.modal-copy > *',{y:12,autoAlpha:0,duration:.2,stagger:.025,ease:'power2.in'}).to('.modal-art .plant-photo',{scale:1.12,filter:'brightness(1.8) saturate(1.8)',duration:.3,ease:'power2.in'},0).to('.modal-layout',{scale:.94,autoAlpha:0,duration:.22,ease:'power2.in'},.08)}else{dialog.close();delete dialog.dataset.closing}};
    document.querySelector('#closeDialog').onclick=closeDialog;dialog.addEventListener('click',e=>{if(e.target===dialog)closeDialog()});dialog.addEventListener('cancel',e=>{e.preventDefault();closeDialog()});
    document.querySelectorAll('.filter[data-filter]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelector('.filter.active').classList.remove('active');btn.classList.add('active');document.querySelectorAll('.card').forEach(card=>card.hidden=btn.dataset.filter!=='all'&&card.dataset.group!==btn.dataset.filter)}));
    document.querySelector('#randomSpecimen').addEventListener('click',()=>{const visible=[...grid.querySelectorAll('.card:not([hidden])')];if(visible.length)visible[Math.floor(Math.random()*visible.length)].click()});
    document.querySelector('#heroPlant').innerHTML=photo('welwitschia','纳米布沙漠中的千岁兰')+`<span class="specimen-label">千岁兰 · WELWITSCHIA MIRABILIS</span>`;
  </script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script><script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script>
    document.querySelectorAll('[data-split]').forEach(el=>{el.innerHTML=[...el.textContent].map(ch=>`<span class="hero-letter" aria-hidden="true">${ch===' '?'&nbsp;':ch}</span>`).join('')});
    const heroArt=document.querySelector('.hero-art');
    heroArt.addEventListener('pointermove',e=>{const r=heroArt.getBoundingClientRect();heroArt.style.setProperty('--pointer-x',`${(e.clientX-r.left)/r.width*100}%`);heroArt.style.setProperty('--pointer-y',`${(e.clientY-r.top)/r.height*100}%`);heroArt.classList.add('is-active')});heroArt.addEventListener('pointerleave',()=>heroArt.classList.remove('is-active'));
    if(window.gsap){gsap.registerPlugin(ScrollTrigger);const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
      if(!reduce){const intro=gsap.timeline({defaults:{ease:'power3.out'}});intro.from('.eyebrow',{x:-30,autoAlpha:0,duration:.6}).from('.hero-letter',{yPercent:125,rotationX:-65,autoAlpha:0,duration:.8,stagger:.045,transformOrigin:'50% 100%'},'-=.2').from('.hero-sub,.hero-cta',{y:22,autoAlpha:0,duration:.6,stagger:.12},'-=.35').from('.specimen .plant-photo',{scale:1.28,rotation:-9,clipPath:'circle(16% at 50% 50%)',filter:'brightness(2) saturate(2)',autoAlpha:0,duration:1.4},'-=1').from('.orbit',{scale:.7,rotation:-80,autoAlpha:0,duration:1.4},'-=1.1').from('.hud,.crosshair,.data-ribbon',{autoAlpha:0,scale:.7,duration:.55,stagger:.09},'-=.8');
        gsap.to('.specimen .plant-photo',{y:-8,rotation:1.2,scale:1.035,duration:3.8,repeat:-1,yoyo:true,ease:'sine.inOut'});gsap.to('.orbit',{rotation:360,duration:80,repeat:-1,ease:'none'});gsap.to('.hero-index',{y:-7,duration:1.8,repeat:-1,yoyo:true,ease:'sine.inOut'});
        gsap.utils.toArray('.card').forEach((card,i)=>{gsap.from(card,{y:58,rotationX:8,autoAlpha:0,duration:.8,delay:(i%3)*.1,ease:'power3.out',scrollTrigger:{trigger:card,start:'top 91%',once:true}});card.addEventListener('pointermove',e=>{const r=card.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;card.querySelector('.card-visual').style.setProperty('--pointer-x',`${(x+.5)*100}%`);card.querySelector('.card-visual').style.setProperty('--pointer-y',`${(y+.5)*100}%`);gsap.to(card.querySelector('.plant-photo'),{x:x*15,y:y*12,scale:1.1,rotationY:x*5,filter:'brightness(1.16) saturate(1.35) contrast(1.1)',duration:.35,overwrite:true});});card.addEventListener('pointerleave',()=>gsap.to(card.querySelector('.plant-photo'),{x:0,y:0,rotationY:0,scale:1,filter:'brightness(.86) saturate(.94) contrast(1.12)',duration:.65,ease:'power3.out',overwrite:true}));});
        heroArt.addEventListener('pointermove',()=>gsap.to('.specimen .plant-photo',{scale:1.08,filter:'brightness(1.2) saturate(1.5) contrast(1.15)',duration:.55,overwrite:true}));heroArt.addEventListener('pointerleave',()=>gsap.to('.specimen .plant-photo',{scale:1.035,filter:'brightness(.86) saturate(.94) contrast(1.12)',duration:.7,overwrite:true}));
        gsap.from('.manifesto-inner',{y:42,autoAlpha:0,duration:.9,scrollTrigger:{trigger:'.manifesto',start:'top 78%',once:true}});gsap.to('.hero-art',{yPercent:11,ease:'none',scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1.2}});gsap.utils.toArray('.section-head').forEach(h=>gsap.from(h,{x:-30,autoAlpha:0,duration:.7,scrollTrigger:{trigger:h,start:'top 87%',once:true}}));
        grid.addEventListener('click',e=>{const card=e.target.closest('.card');if(!card)return;gsap.set(dialog,{autoAlpha:1});gsap.fromTo('.modal-layout',{scale:.86,y:45,autoAlpha:0,filter:'blur(14px)'},{scale:1,y:0,autoAlpha:1,filter:'blur(0px)',duration:.65,ease:'power4.out'});gsap.fromTo('.modal-art .plant-photo',{clipPath:'inset(0 0 100% 0)',scale:1.22,filter:'brightness(2.2) saturate(1.6)'},{clipPath:'inset(0 0 0% 0)',scale:1,filter:'brightness(.9) saturate(.93)',duration:.9,ease:'power3.inOut',delay:.08});gsap.fromTo('.modal-copy > *',{y:22,autoAlpha:0},{y:0,autoAlpha:1,duration:.42,stagger:.065,ease:'power3.out',delay:.18});gsap.fromTo('.scan-lens',{scale:.55,autoAlpha:0},{scale:1,autoAlpha:1,duration:.5,delay:.65,ease:'back.out(1.7)'});});
      }
    }
  </script>
